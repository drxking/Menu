<%- include('partials/header') %><main class="shell page"><section class="renew-wrap"><a class="back-link" href="/dashboard/subscription">← Back to subscription</a><div class="eyebrow">RENEW SUBSCRIPTION</div><h1 class="page-title">Make payment.</h1><p class="muted">Choose a plan, pay using the bank QR, then upload your payment receipt for approval.</p><form method="post" enctype="multipart/form-data" class="renew-grid"><section class="editor-card"><h2>1. Choose plan</h2><div class="renew-plan-options"><% Object.entries(plans).forEach(([key, plan]) => { %><label class="renew-plan"><input type="radio" name="plan" value="<%= key %>" required><span><strong><%= plan.label %></strong><small><%= plan.days %> days</small></span><b>₹<%= plan.price %></b></label><% }) %></div><h2>2. Upload proof</h2><label class="field">Transaction ID <span class="muted">(optional)</span><input name="reference" placeholder="Payment reference"></label><label class="field">Payment screenshot / receipt<input name="paymentImage" type="file" accept="image/*" required></label><button>Submit payment for approval</button></section><aside class="bank-qr"><div class="eyebrow">3. PAY WITH BANK QR</div><% if(bankQrUrl){ %><img src="<%= bankQrUrl %>" alt="Bank payment QR code"><% } else { %><div class="bank-qr-placeholder">ADD YOUR<br>BANK QR URL<br>IN .ENV</div><% } %><p class="muted">After payment, upload a screenshot or receipt. Your menu will be enabled after approval.</p></aside></form></section></main><%- include('partials/footer') %>
