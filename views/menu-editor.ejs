<%- include('partials/header') %>
<main class="shell page menu-workspace">
  <div class="eyebrow">MENU BUILDER</div>
  <div class="editor-heading"><div><h1 class="page-title">Your menu.</h1><p class="muted"><%= restaurant.status === 'trial' ? `${collectionCount}/3 collections · ${productCount}/10 products used during free trial` : 'Unlimited collections and products' %></p></div><a class="button ghost" href="/menu/<%= restaurant.slug %>" target="_blank">Open live menu ↗</a></div>
  <div class="menu-workspace-grid">
    <aside class="categories-panel"><div class="panel-heading"><h2>Collections</h2><span><%= collectionCount %></span></div><form method="post" action="/dashboard/menu/collection" class="add-category"><input name="name" placeholder="New collection" required><button>Add</button></form><div class="category-list"><% if (!restaurant.collections.length) { %><p class="muted">Add your first collection to start building the menu.</p><% } %><% restaurant.collections.forEach(c => { %><div class="category-item"><strong><%= c.name %></strong><small><%= c.products.length %> product<%= c.products.length === 1 ? '' : 's' %></small></div><% }) %></div></aside>
    <section class="products-panel"><div class="panel-heading"><h2>Products</h2><span><%= productCount %> total</span></div><% if (restaurant.collections.length) { %><div class="add-product-layout"><form id="add-product-form" method="post" action="/dashboard/menu/product" enctype="multipart/form-data" class="product-form"><label class="field">Category<select id="add-category-select" name="collectionId"><% restaurant.collections.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label class="field">Name<input id="add-product-name" name="name" placeholder="e.g. Spiced potatoes" required></label><label class="field">Description<textarea id="add-product-description" name="description" placeholder="A short, appetising description"></textarea></label><label class="field">Price<input id="add-product-price" name="price" type="number" step="0.01" min="0" placeholder="0.00" required></label><label class="field">Product image <span class="muted">(optional, max 5 MB)</span><input id="add-product-image" name="image" type="file" accept="image/*"></label><button>Add product</button></form><aside class="add-product-preview"><div class="preview-label"><span class="eyebrow">CUSTOMER PREVIEW</span><span>New product</span></div><article class="preview-product"><div id="preview-image-wrap" class="preview-image-wrap"><span>Food image</span><img id="preview-image" alt=""></div><div class="preview-product-copy"><strong id="preview-name">Product name</strong><p id="preview-description">Your description appears here.</p><b id="preview-price">$0.00</b></div></article></aside></div><% } else { %><div class="empty-products"><h3>Add a collection first.</h3><p class="muted">Products belong to a collection.</p></div><% } %><section class="product-table"><% restaurant.collections.forEach(c => { %><div class="product-group"><h3><%= c.name %></h3><% c.products.forEach(p => { %><a class="product-row" href="/dashboard/menu/products/<%= p.id %>/edit"><% if(p.imageUrl){ %><img src="<%= p.imageUrl %>" alt=""><% } else { %><span class="product-placeholder">—</span><% } %><span><strong><%= p.name %></strong><small><%= p.description || 'No description' %></small></span><b>$<%= p.price.toFixed(2) %> · Edit →</b></a><% }) %></div><% }) %></section>
    </section>
  </div>
</main>
<script>const $=(id)=>document.getElementById(id);const name=$('add-product-name'),description=$('add-product-description'),price=$('add-product-price'),image=$('add-product-image');if(name){name.addEventListener('input',()=>{$('preview-name').textContent=name.value||'Product name'});description.addEventListener('input',()=>{$('preview-description').textContent=description.value||'Your description appears here.'});price.addEventListener('input',()=>{$('preview-price').textContent='₹'+(Number(price.value||0)).toFixed(2)});image.addEventListener('change',()=>{const file=image.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{$('preview-image').src=reader.result;$('preview-image-wrap').classList.add('has-image')};reader.readAsDataURL(file)})}</script>
<%- include('partials/footer') %>
