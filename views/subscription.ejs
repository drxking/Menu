<%- include('partials/header') %><main class="shell page"><div class="eyebrow">SUBSCRIPTION</div><div class="editor-heading"><div><h1 class="page-title">Keep your menu live.</h1><p class="muted"><% if (restaurant.status === 'active') { %>Your plan has <%= days %> day<%= days === 1 ? '' : 's' %> remaining.<% } else if (restaurant.paymentStatus === 'submitted') { %>Your payment is awaiting approval.<% } else { %>Choose a plan to publish your menu.<% } %></p></div><a class="button" href="/dashboard/subscription/renew">Renew subscription</a></div><section class="panel subscription-plans"><h2>Available plans</h2><div class="plans"><% Object.values(plans).forEach(plan => { %><article class="plan"><div class="plan-name"><%= plan.label %></div><div class="price">₹<%= plan.price %></div><p class="muted"><%= plan.days %> days of menu access</p></article><% }) %></div></section><section class="payment-history"><div class="panel-heading"><h2>Payment history</h2><span><%= payments.length %> payment<%= payments.length === 1 ? '' : 's' %></span></div><% if (!payments.length) { %><div class="history-empty">No payment requests yet.</div><% } %><% payments.forEach(payment => { const plan = plans[payment.planCode]; %><article class="history-row"><div><strong><%= plan ? plan.label : payment.planCode %></strong><small><%= new Date(payment.submittedAt).toLocaleDateString() %><% if(payment.reference){ %> · Ref: <%= payment.reference %><% } %></small></div><span class="payment-status <%= payment.status %>"><%= payment.status %></span><strong>₹<%= plan ? plan.price : 0 %></strong></article><% }) %></section></main><%- include('partials/footer') %>
