<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= restaurant.name %></title><meta name="description" content="<%= restaurant.slogan || `Explore the menu for ${restaurant.name}.` %>"><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/uploads.css"><link rel="stylesheet" href="/restaurant-menu.css"><link rel="stylesheet" href="/restaurant-overrides.css"><script defer src="/currency.js"></script></head><body class="restaurant-site"><header class="public-header"><div class="shell"><div class="public-menu-label">DIGITAL MENU</div><h1><%= restaurant.name %></h1><% if (restaurant.slogan) { %><p class="restaurant-slogan"><%= restaurant.slogan %></p><% } %></div></header><main class="shell public-menu"><% restaurant.collections.forEach(collection => { %><section class="menu-section"><h2><%= collection.name %></h2><% collection.products.forEach(product => { %><article class="product"><div><% if(product.imageUrl){ %><img class="product-image" src="<%= product.imageUrl %>" alt="<%= product.name %>"><% } %><strong><%= product.name %></strong><p><%= product.description %></p></div><strong>₹<%= product.price.toFixed(2) %></strong></article><% }) %></section><% }) %></main></body></html>
