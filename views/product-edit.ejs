<%- include('partials/header') %><main class="shell page product-edit-page"><a class="back-link" href="/dashboard/menu">← Back to menu</a><section class="edit-product-content"><div class="eyebrow">EDIT PRODUCT</div><h1 class="page-title"><%= product.name %></h1><form class="editor-card edit-form" method="post" enctype="multipart/form-data"><label class="field">Category<select name="collectionId"><% restaurant.collections.forEach(c => { %><option value="<%= c.id %>" <%= String(c.id) === String(product.categoryId) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></label><label class="field">Product name<input name="name" value="<%= product.name %>" required></label><label class="field">Description<textarea name="description"><%= product.description || '' %></textarea></label><label class="field">Price<input name="price" type="number" step="0.01" min="0" value="<%= product.price.toFixed(2) %>" required></label><% if(product.imageUrl){ %><img class="edit-image" src="<%= product.imageUrl %>" alt="Current product image"><% } %><label class="field">Replace product image <span class="muted">(optional)</span><input name="image" type="file" accept="image/*"></label><button>Save changes</button></form></section></main><%- include('partials/footer') %>
