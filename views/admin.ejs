<%- include('partials/header') %><main class="shell page"><div class="eyebrow">SUPERADMIN / OPERATIONS</div><div class="editor-heading"><div><h1 class="page-title">Restaurants.</h1><p class="muted">Manage restaurant access, status, and expiry dates.</p></div><a class="button" href="/admin/payments">Payment requests</a></div><section class="admin-management"><div class="admin-management-head"><span>RESTAURANT</span><span>STATUS & EXPIRY</span><span>PLAN</span><span>SAVE</span></div><% restaurants.forEach(restaurant => { %><form class="admin-management-row" method="post" action="/admin/restaurants/<%= restaurant.id %>/manage"><div><strong><%= restaurant.name %></strong><small><%= restaurant.email %></small></div><div class="manage-fields"><select name="status"><% ['trial','pending','active','suspended'].forEach(status => { %><option value="<%= status %>" <%= restaurant.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select><input name="expiryDate" type="date" value="<%= restaurant.subscriptionEndsAt ? new Date(restaurant.subscriptionEndsAt).toISOString().slice(0,10) : '' %>"></div><div><strong><%= restaurant.selectedPlan && plans[restaurant.selectedPlan] ? plans[restaurant.selectedPlan].label : 'Free trial' %></strong><small><%= restaurant.paymentStatus || 'No payment' %></small></div><button>Save</button></form><% }) %></section></main><%- include('partials/footer') %>
