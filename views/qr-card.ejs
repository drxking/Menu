<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= restaurant.name %> QR</title><link rel="stylesheet" href="/styles.css"><link rel="stylesheet" href="/qr-card.css"></head><body class="qr-print-page"><button class="print-action" onclick="window.print()">Print QR card</button><section class="restaurant-qr-card"><div class="qr-copy"><div><p class="qr-kicker">DIGITAL MENU</p><h1><%= restaurant.name %></h1><% if (restaurant.slogan) { %><p class="qr-slogan"><%= restaurant.slogan %></p><% } %></div><p class="qr-credit">Created by Menu.app</p></div><div class="qr-code"><img src="<%= qr %>" alt="QR code for <%= restaurant.name %> menu"><p>SCAN QR CODE<br>FOR MENU</p></div></section></body></html>
