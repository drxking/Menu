<%- include('partials/header') %><main class="shell page"><div class="eyebrow">RESTAURANT CONTROL ROOM</div><h1 class="page-title"><%= restaurant.name %></h1><% if(!active){ %><div class="notice warning">Your account is <strong><%= restaurant.status %></strong>. Select a plan and submit payment to publish your menu.</div><% } else if(days <= 5){ %><div class="notice">Your subscription expires in <strong><%= days %> day<%= days === 1 ? '' : 's' %></strong>. Renew now to keep your menu live.</div><% } %><section class="grid"><article class="panel"><div class="eyebrow">ACCOUNT STATUS</div><p class="stat"><%= active ? 'LIVE' : restaurant.status.toUpperCase() %></p></article><article class="panel"><div class="eyebrow">DAYS REMAINING</div><p class="stat"><%= days %></p></article><article class="panel"><div class="eyebrow">PUBLIC URL</div><p><a href="/menu/<%= restaurant.slug %>" target="_blank">/menu/<%= restaurant.slug %></a></p></article></section><div class="toolbar" style="margin-top:28px"><a class="button" href="/dashboard/menu">Edit menu</a><a class="button ghost" href="/dashboard/profile">Edit profile</a><a class="button ghost" href="/dashboard/qr">Print QR card</a><a class="button ghost" href="/dashboard/subscription">Subscription</a></div></main><%- include('partials/footer') %>
