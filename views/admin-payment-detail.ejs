<%- include('partials/header') %><main class="shell page"><a class="back-link" href="/admin/payments">← Payment requests</a><div class="eyebrow">PAYMENT REQUEST</div><h1 class="page-title"><%= restaurant?.name || 'Restaurant unavailable' %></h1><section class="payment-detail-grid"><article class="panel"><h2>Request details</h2><dl class="detail-list"><div><dt>Plan</dt><dd><%= plan?.label || payment.planCode %> · ₹<%= plan?.price || 0 %></dd></div><div><dt>Payment status</dt><dd class="payment-status <%= payment.status %>"><%= payment.status %></dd></div><div><dt>Requested on</dt><dd><%= new Date(payment.submittedAt).toLocaleString() %></dd></div><div><dt>Transaction ID</dt><dd><%= payment.reference || 'Not provided' %></dd></div><div><dt>Current restaurant expiry</dt><dd><%= restaurant?.subscriptionEndsAt ? new Date(restaurant.subscriptionEndsAt).toLocaleString() : 'Not set' %></dd></div><div><dt>Restaurant email</dt><dd><%= user?.email || 'Not available' %></dd></div></dl><% if(payment.status === 'submitted'){ %><form method="post" action="/admin/payments/<%= payment.id %>/approve"><button>Approve payment & activate</button></form><% } %></article><aside class="payment-proof"><div class="eyebrow">UPLOADED PAYMENT PROOF</div><% if(payment.paymentImageUrl){ %><img src="<%= payment.paymentImageUrl %>" alt="Payment proof for <%= restaurant?.name %>"><% } else { %><p class="muted">No payment image was uploaded for this request.</p><% } %></aside></section></main><%- include('partials/footer') %>
