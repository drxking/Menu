<%- include('partials/header') %><main class="shell page"><section class="form-wrap"><a class="back-link" href="/dashboard">← Back to dashboard</a><div class="eyebrow">RESTAURANT PROFILE</div><h1>Edit profile.</h1><p class="muted">Your public menu URL and printed QR code remain unchanged when you update your name.</p><form method="post" class="editor-card"><label class="field">Restaurant name<input name="name" maxlength="160" value="<%= restaurant.name %>" required></label><label class="field">Slogan or short description<input name="slogan" maxlength="180" value="<%= restaurant.slogan || '' %>" placeholder="e.g. Fire-cooked food, poured with care"></label><button>Save profile</button></form></section></main><%- include('partials/footer') %>
