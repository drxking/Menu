<%- include('partials/header') %><main class="shell page"><a class="back-link" href="/admin">← Restaurant management</a><div class="eyebrow">SUPERADMIN / PAYMENTS</div><h1 class="page-title">Payment requests.</h1><section class="admin-payment-list"><div class="admin-payment-head"><span>RESTAURANT</span><span>PLAN</span><span>STATUS</span><span>REQUESTED</span><span></span></div><% if(!payments.length){ %><p class="history-empty">No payment requests yet.</p><% } %><% payments.forEach(payment => { const plan = plans[payment.planCode]; %><article class="admin-payment-row"><div><strong><%= payment.restaurant?.name || 'Deleted restaurant' %></strong><small><%= payment.restaurant?.email || '' %></small></div><span><%= plan?.label || payment.planCode %> · ₹<%= plan?.price || 0 %></span><span class="payment-status <%= payment.status %>"><%= payment.status %></span><span><%= new Date(payment.submittedAt).toLocaleDateString() %></span><a class="button ghost" href="/admin/payments/<%= payment.id %>">View details</a></article><% }) %></section></main><%- include('partials/footer') %>
